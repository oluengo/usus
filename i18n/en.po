msgid "¿Borrar este registro de peso?"
msgstr "Delete this weight entry?"

msgid "¿Borrar los datos para el análisis? El resto de datos no se toca."
msgstr "Delete the analysis data? Nothing else is touched."

msgid "¿Cómo quieres empezar?"
msgstr "How do you want to start?"

msgid "¿Consolidar antes?"
msgstr "Consolidate first?"

msgid "¿Cuántas te quedaban?"
msgstr "How many were left in the tank?"

msgid "¿Cuánto más habrías aguantado?"
msgstr "How much longer could you have held?"

msgid "¿Cuánto te ha costado?"
msgstr "How hard was it?"

msgid "¿Descartar la sesión en curso? Se perderán los datos."
msgstr "Discard the current session? Its data will be lost."

#, python-brace-format
msgid "¿Eliminar el plan «{x}»? Tus rutinas y sesiones no se tocan."
msgstr "Delete the plan “{x}”? Your routines and sessions aren't touched."

msgid "¿Eliminar el plan? Tus rutinas y sesiones no se tocan."
msgstr "Delete the plan? Your routines and sessions are not affected."

msgid "¿Eliminar esta actividad?"
msgstr "Delete this activity?"

msgid "¿Eliminar esta rutina? Las sesiones registradas se conservan."
msgstr "Delete this routine? Logged sessions are kept."

msgid "¿Eliminar esta sesión? No se puede deshacer."
msgstr "Delete this session? This can't be undone."

msgid "¿Eliminar este suplemento? Su historial también se dejará de mostrar."
msgstr "Delete this supplement? Its history will no longer be shown either."

msgid "¿Hacer descarga esta semana? Solo se sugieren las rutinas de todas las semanas, y el resto del plan se corre una semana."
msgstr "Make this a deload week? Only every-week routines are suggested, and the rest of the plan moves one week later."

msgid "¿Has notado la vibración?"
msgstr "Did you feel the vibration?"

msgid "¿Has oído 3 pitidos y notado la vibración?"
msgstr "Did you hear 3 beeps and feel the vibration?"

msgid "¿Has oído 3 pitidos?"
msgstr "Did you hear 3 beeps?"

msgid "¿Le puede servir a alguien? Envíale el enlace."
msgstr "Could it help someone? Send them the link."

#, python-brace-format
msgid "¿Pasar igualmente a {x}? Las series pendientes quedan sin hacer."
msgstr "Move on to {x} anyway? Pending sets stay undone."

#, python-brace-format
msgid "¿Quitar \"{x}\" de la sesión?"
msgstr "Remove \"{x}\" from the session?"

msgid "¿Quitar la regla que empieza este día?"
msgstr "Remove the period that starts on this day?"

#, python-brace-format
msgid "¿Quitar la sección «{x}»? Los ejercicios se quedan en la rutina."
msgstr "Remove the section “{x}”? The exercises stay in the routine."

#, python-brace-format
msgid "¿Quitar la sección «{x}»? Sus ejercicios pasan a «{y}»."
msgstr "Remove the section “{x}”? Its exercises move to “{y}”."

