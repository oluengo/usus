#, python-brace-format
msgid "¿Terminar y guardar igualmente? Se guardan solo las series hechas ({n} pendientes en total)."
msgstr "Vols acabar i desar igualment? Només es desen les sèries fetes ({n} pendents en total)."

msgid "«Añadir app» y pega el enlace:"
msgstr "«Afegeix app» i enganxa l'enllaç:"

msgid "«Ejercicio hecho» bien visible, con el descanso que viene y el botón al siguiente."
msgstr "«Exercici fet» ben visible, amb el descans que ve i el botó al següent."

msgid "«Notas del periodo» en todas las pestañas de Stats, y las notas de cada ejercicio en su historial."
msgstr "«Notes del període» a totes les pestanyes de Stats, i les notes de cada exercici al seu historial."

