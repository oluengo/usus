msgid "¿Borrar este registro de peso?"
msgstr "Vols esborrar aquest registre de pes?"

msgid "¿Borrar los datos para el análisis? El resto de datos no se toca."
msgstr "Esborrar les dades per a l'anàlisi? La resta de dades no es toca."

msgid "¿Cómo quieres empezar?"
msgstr "Com vols començar?"

msgid "¿Consolidar antes?"
msgstr "Consolidar abans?"

msgid "¿Cuántas te quedaban?"
msgstr "Quantes te'n quedaven?"

msgid "¿Cuánto más habrías aguantado?"
msgstr "Quant més hauries aguantat?"

msgid "¿Cuánto te ha costado?"
msgstr "Quant t'ha costat?"

msgid "¿Descartar la sesión en curso? Se perderán los datos."
msgstr "Vols descartar la sessió en curs? Es perdran les dades."

#, python-brace-format
msgid "¿Eliminar el plan «{x}»? Tus rutinas y sesiones no se tocan."
msgstr "Eliminar el pla «{x}»? Les teves rutines i sessions no es toquen."

msgid "¿Eliminar el plan? Tus rutinas y sesiones no se tocan."
msgstr "Vols eliminar el pla? Les rutines i sessions no es toquen."

msgid "¿Eliminar esta actividad?"
msgstr "Eliminar aquesta activitat?"

msgid "¿Eliminar esta rutina? Las sesiones registradas se conservan."
msgstr "Vols eliminar aquesta rutina? Les sessions registrades es conserven."

msgid "¿Eliminar esta sesión? No se puede deshacer."
msgstr "Vols eliminar aquesta sessió? No es pot desfer."

msgid "¿Eliminar este suplemento? Su historial también se dejará de mostrar."
msgstr "Vols eliminar aquest suplement? El seu historial també deixarà de mostrar-se."

msgid "¿Hacer descarga esta semana? Hasta el domingo solo se sugieren las rutinas de todas las semanas, y el plan no avanza."
msgstr "Fer descàrrega aquesta setmana? Fins diumenge només se suggereixen les rutines de totes les setmanes, i el pla no avança."

msgid "¿Has notado la vibración?"
msgstr "Has notat la vibració?"

msgid "¿Has oído 3 pitidos y notado la vibración?"
msgstr "Has sentit 3 xiulets i notat la vibració?"

msgid "¿Has oído 3 pitidos?"
msgstr "Has sentit 3 xiulets?"

msgid "¿Le puede servir a alguien? Envíale el enlace."
msgstr "Li pot servir a algú? Envia-li l'enllaç."

#, python-brace-format
msgid "¿Pasar igualmente a {x}? Las series pendientes quedan sin hacer."
msgstr "Vols passar igualment a {x}? Les sèries pendents queden sense fer."

#, python-brace-format
msgid "¿Quitar \"{x}\" de la sesión?"
msgstr "Vols treure \"{x}\" de la sessió?"

msgid "¿Quitar la regla que empieza este día?"
msgstr "Vols treure la regla que comença aquest dia?"

#, python-brace-format
msgid "¿Quitar la sección «{x}»? Los ejercicios se quedan en la rutina."
msgstr "Treure la secció «{x}»? Els exercicis es queden a la rutina."

#, python-brace-format
msgid "¿Quitar la sección «{x}»? Sus ejercicios pasan a «{y}»."
